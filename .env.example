# Copy to .env and adjust, or set these in your shell before starting the server.
# Every value here is the default; nothing needs to be set to run.

# --- ASR -------------------------------------------------------------------
ASR_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
# Pin this in any deployment: the model runs remote code from the Hub.
ASR_REVISION=main
ASR_LANGUAGE=ta
ASR_EAGER_LOAD=1
# Required: the AI4Bharat repo is gated. Accept its terms on the Hub, then put a
# read token here (or run `huggingface-cli login` and leave this blank).
HF_TOKEN=

# --- audio -----------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=3600
CHUNK_SEC=30
CHUNK_OVERLAP_SEC=2
SILENCE_TOP_DB=35

# --- serving ---------------------------------------------------------------
MAX_CONCURRENCY=1
# 0 leaves torch to decide; otherwise match your physical core count.
TORCH_THREADS=0

# --- pronunciation (text-to-speech) --------------------------------------
# A Microsoft neural Tamil voice: ta-IN-PallaviNeural (female) or
# ta-IN-ValluvarNeural (male). Needs internet the first time each sound is
# rendered; results are cached under cache/pronounce.
TTS_VOICE=ta-IN-PallaviNeural
TTS_WARM_CACHE=1

# --- doctor portal: accounts, tasks, lessons ----------------------------------
# PostgreSQL connection. This default is the container `docker compose up -d`
# starts (see docker-compose.yml). For your own server use
# postgresql://USER:PASSWORD@HOST:5432/DBNAME and make sure the role owns the
# database (it creates the tables and the citext extension on first start).
DATABASE_URL=postgresql://tamiltutor:tamiltutor@127.0.0.1:5433/tamiltutor
DB_POOL_SIZE=5
# The tests use a separate database; by default DATABASE_URL with the name
# replaced by tamiltutor_test (created on the first run).
# TEST_DATABASE_URL=postgresql://tamiltutor:tamiltutor@127.0.0.1:5433/tamiltutor_test
# Secret that signs the JWT sign-in tokens. REQUIRED for real use: generate one
# with `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Left
# empty, a random secret is made per start and everyone is signed out on restart.
JWT_SECRET=
# The address of this server as a browser reaches it: it is what invite
# e-mails link to. Use the LAN address if children use other machines.
PUBLIC_URL=http://127.0.0.1:8000
# The first doctor account, created on the first start (change the password
# afterwards in the dashboard's Settings, or run scripts/create_doctor.py).
DOCTOR_NAME=Dr. Tamil Tutor
DOCTOR_EMAIL=doctor@tamiltutor.local
DOCTOR_PASSWORD=doctor123
# How long a sign-in (JWT) and an account-creation link stay valid.
SESSION_DAYS=7
INVITE_DAYS=7
# Invite e-mail. Leave SMTP_HOST empty to skip sending: the activation link is
# then shown in the dashboard to copy and share by hand.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<an app password>, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
# Upload limits (MB) for student photos and video lessons.
MAX_PHOTO_MB=5
MAX_VIDEO_MB=500
# Where photos and videos are kept (accounts live in PostgreSQL).
# PORTAL_DATA_DIR=data
